SUBS(ABRC, "<>"SS_TAP(X_LEFT),   KC_G, KC_H)
SUBS(PARN, "()"SS_TAP(X_LEFT),   KC_F, KC_J)
SUBS(CBRC, "{}"SS_TAP(X_LEFT),   KC_D, KC_K)
SUBS(BRCE, "[]"SS_TAP(X_LEFT),   KC_S, KC_L)
SUBS(QUOT, "''"SS_TAP(X_LEFT),   KC_A, KC_SCLN)
SUBS(DQUO, "\"\""SS_TAP(X_LEFT), KC_A, KC_QUOT)

SUBS(SABRC, "<  >"SS_TAP(X_LEFT)SS_TAP(X_LEFT),   KC_SPC, KC_G, KC_H)
SUBS(SPARN, "(  )"SS_TAP(X_LEFT)SS_TAP(X_LEFT),   KC_SPC, KC_F, KC_J)
SUBS(SCBRC, "{  }"SS_TAP(X_LEFT)SS_TAP(X_LEFT),   KC_SPC, KC_D, KC_K)
SUBS(SBRCE, "[  ]"SS_TAP(X_LEFT)SS_TAP(X_LEFT),   KC_SPC, KC_S, KC_L)
SUBS(SQUOT, "'  '"SS_TAP(X_LEFT)SS_TAP(X_LEFT),   KC_SPC, KC_A, KC_SCLN)
SUBS(SDQUO, "\"  \""SS_TAP(X_LEFT)SS_TAP(X_LEFT), KC_SPC, KC_A, KC_QUOT)

SUBS(SNIF, "if ()"SS_TAP(X_LEFT), KC_D, KC_F)
SUBS(SNLM, " => ",                KC_K, KC_L)

COMB(ESC, KC_ESC, KC_J, KC_K)
