/* Function macros */
COMB(COMBO_F1,    KC_F1,  KM_1,    KM_Q)
COMB(COMBO_F2,    KC_F2,  KM_2,    KM_W)
COMB(COMBO_F3,    KC_F3,  KM_3,    KM_E)
COMB(COMBO_F4,    KC_F4,  KM_4,    KM_R)
COMB(COMBO_F5,    KC_F5,  KM_5,    KM_T)
COMB(COMBO_F6,    KC_F6,  KM_6,    KM_Y)
COMB(COMBO_F7,    KC_F7,  KM_7,    KM_U)
COMB(COMBO_F8,    KC_F8,  KM_8,    KM_I)
COMB(COMBO_F9,    KC_F9,  KM_9,    KM_O)
COMB(COMBO_F10,   KC_F10, KM_0,    KM_P)
COMB(COMBO_F11,   KC_F11, KM_9, KM_BSPC)
COMB(COMBO_F12,   KC_F12, KM_0, KM_BSPC)

/* Symbol macros */
COMB(COMBO_GRV2, KC_GRV,  KM_DEL,  KM_1)
COMB(COMBO_TLD2, KC_TILD, KM_DEL,  KM_TAB)

SUBS(COMBO_AND,  " && ",  KM_TAB,  KM_MINS)
COMB(COMBO_EXLM, KC_EXLM, KM_Q,    KM_A)
COMB(COMBO_AT,   KC_AT,   KM_W,    KM_S)
COMB(COMBO_HASH, KC_HASH, KM_E,    KM_D)
COMB(COMBO_DLR,  KC_DLR,  KM_R,    KM_F)
COMB(COMBO_PERC, KC_PERC, KM_T,    KM_G)
COMB(COMBO_CIRC, KC_CIRC, KM_Y,    KM_H)
COMB(COMBO_AMPR, KC_AMPR, KM_U,    KM_J)
COMB(COMBO_ASTR, KC_ASTR, KM_I,    KM_K)
COMB(COMBO_PIPE, KC_PIPE, KM_O,    KM_L)
COMB(COMBO_COLN, KC_PLUS, KM_P,    KM_SCLN)
SUBS(COMBO_OR,   " || ",  KM_LEAD, KM_QUOT)

COMB(COMBO_UNDS, KC_UNDS, KM_MINS, KM_EQL)
COMB(COMBO_PLUS, KC_PLUS, KM_A,    KM_Z)
COMB(COMBO_LBRC, KC_LBRC, KM_S,    KM_X)
COMB(COMBO_LCBR, KC_LCBR, KM_D,    KM_C)
COMB(COMBO_LPRN, KC_LPRN, KM_F,    KM_V)
COMB(COMBO_LABK, KC_LABK, KM_G,    KM_B)
COMB(COMBO_RABK, KC_RABK, KM_H,    KM_N)
COMB(COMBO_RPRN, KC_RPRN, KM_J,    KM_M)
COMB(COMBO_RCBR, KC_RCBR, KM_K,    KM_COMM)
COMB(COMBO_RBRC, KC_RBRC, KM_L,    KM_DOT)
COMB(COMBO_QUES, KC_QUES, KM_SCLN, KM_SLSH)
COMB(COMBO_DQUO, KC_DQUO, KM_QUOT, KM_BSLS)

/* Meta macros */
COMB(COMBO_JKESC, KC_ESC, KM_J, KM_K)
COMB(COMBO_DFESC, KC_ESC, KM_D, KM_F)
COMB(COMBO_RESET, QK_BOOT, KM_Q, KM_W, KM_E, KM_R, KM_U, KM_I, KM_O, KM_P)
COMB(COMBO_COMUP, KC_UP, KC_COMM, KC_DOWN)

/* Lambda macros */
SUBS(COMBO_LMSY, " => ", KM_COMM, KM_DOT)
SUBS(COMBO_LMAL, "() => {  }"SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT), KM_C, KM_COMM)
SUBS(COMBO_LMAR, "() => {  }"SS_TAP(X_LEFT)SS_TAP(X_LEFT), KM_C, KM_DOT)
SUBS(COMBO_LMBL, "() => "SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT), KM_X, KM_COMM)
SUBS(COMBO_LMBR, "() => ", KM_X, KM_DOT)

TOGG(COMBO_WASD, LAYER_GAMES, KM_W, KM_A, KM_S, KM_D)
