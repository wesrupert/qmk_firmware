/* Symbol layer */
SUBS(COMBO_ANDU, " && ",  KC_A,    KC_Q)
SUBS(COMBO_ANDD, " && ",  KC_A,    KC_Z)
COMB(COMBO_LBRC, KC_LBRC, KC_S,    KC_W)
COMB(COMBO_LCBR, KC_LCBR, KC_D,    KC_E)
COMB(COMBO_LPRN, KC_LPRN, KC_F,    KC_R)
COMB(COMBO_LABK, KC_LABK, KC_G,    KC_T)
COMB(COMBO_RABK, KC_RABK, KC_H,    KC_Y)
COMB(COMBO_RPRN, KC_RPRN, KC_J,    KC_U)
COMB(COMBO_RCBR, KC_RCBR, KC_K,    KC_I)
COMB(COMBO_RBRC, KC_RBRC, KC_L,    KC_O)
SUBS(COMBO_ORU,  " || ",  KC_SCLN, KC_P)
SUBS(COMBO_ORD,  " || ",  KC_SCLN, KC_SLSH)

SUBS(COMBO_LMBD, "() => ", KC_K, KC_L)
SUBS(COMBO_LMPR, "() => ", KC_COMMA, KC_DOT)
SUBS(COMBO_LMPL, "() => "SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT), KC_X, KC_C)

/* Function keys */
COMB(COMBO_F1,  KC_F1,  KC_1, KC_Q)
COMB(COMBO_F2,  KC_F2,  KC_2, KC_W)
COMB(COMBO_F3,  KC_F3,  KC_3, KC_E)
COMB(COMBO_F4,  KC_F4,  KC_4, KC_R)
COMB(COMBO_F5,  KC_F5,  KC_5, KC_T)
COMB(COMBO_F6,  KC_F6,  KC_6, KC_Y)
COMB(COMBO_F7,  KC_F7,  KC_7, KC_U)
COMB(COMBO_F8,  KC_F8,  KC_8, KC_I)
COMB(COMBO_F9,  KC_F9,  KC_9, KC_O)
COMB(COMBO_F10, KC_F10, KC_0, KC_P)
COMB(COMBO_F11, KC_F11, KC_9, KC_BSPC)
COMB(COMBO_F12, KC_F12, KC_0, KC_BSPC)

/* Meta macros */
COMB(COMBO_AF4,   LALT(KC_F4),        KC_7, KC_BSPC)
COMB(COMBO_CSE,   LCTL(LSFT(KC_ESC)), KC_6, KC_BSPC)
COMB(COMBO_JKESC, KC_ESC,             KC_J, KC_K)
COMB(COMBO_DFESC, KC_ESC,             KC_D, KC_F)
COMB(COMBO_CORST, QK_BOOT,            KC_Q, KC_W, KC_E, KC_R, KC_U, KC_I, KC_O, KC_P)

/* Lambda macros */
SUBS(COMBO_LMSY, " => ", KC_COMMA, KC_DOT)
SUBS(COMBO_LMAL, "() => {  }"SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT), KC_C, KC_COMMA)
SUBS(COMBO_LMAR, "() => {  }"SS_TAP(X_LEFT)SS_TAP(X_LEFT), KC_C, KC_DOT)
SUBS(COMBO_LMBL, "() => "SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT), KC_X, KC_COMMA)
SUBS(COMBO_LMBR, "() => ", KC_X, KC_DOT)

/* Custom combos */
COMB(COMBO_WASD, KC_NO, KC_W, KC_A, KC_S, KC_D)
