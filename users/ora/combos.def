SUBS(COMBO_ABRK,  "<>"SS_TAP(X_LEFT),                 KC_GRAVE, KC_SCLN)
SUBS(COMBO_PARN,  "()"SS_TAP(X_LEFT),                 KC_F,     KC_J)
SUBS(COMBO_CBRC,  "{  }"SS_TAP(X_LEFT)SS_TAP(X_LEFT), KC_D,     KC_K)
SUBS(COMBO_ABRC,  "[]"SS_TAP(X_LEFT),                 KC_LBRC,  KC_RBRC)
SUBS(COMBO_QUTS,  "''"SS_TAP(X_LEFT),                 KC_A,     KC_SLSH)
SUBS(COMBO_QUTC,  "''"SS_TAP(X_LEFT),                 KC_A,     KC_SCLN)
SUBS(COMBO_DQUO,  "\"\""SS_TAP(X_LEFT),               KC_A,     KC_QUOT)
SUBS(COMBO_ABRK2, "<>"SS_TAP(X_LEFT),                 KC_SCLN,  KC_QUOT)

SUBS(COMBO_SUIF, "if ()"SS_TAP(X_LEFT),      KC_B, KC_N)
SUBS(COMBO_SUEL, "else if ()"SS_TAP(X_LEFT), KC_V, KC_M)

SUBS(COMBO_LMSY, " => ", KC_COMMA, KC_DOT)
SUBS(COMBO_LMAL, "() => {  }"SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT), KC_C, KC_COMMA)
SUBS(COMBO_LMAR, "() => {  }"SS_TAP(X_LEFT)SS_TAP(X_LEFT), KC_C, KC_DOT)
SUBS(COMBO_LMBL, "() => "SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT), KC_X, KC_COMMA)
SUBS(COMBO_LMBR, "() => ", KC_X, KC_DOT)

COMB(COMBO_COESC, KC_ESC, KC_J, KC_K)
COMB(COMBO_CORST, QK_BOOT, KC_Q, KC_W, KC_E, KC_R, KC_U, KC_I, KC_O, KC_P)

/* Custom combos */
COMB(COMBO_WASD, KC_NO, KC_W, KC_A, KC_S, KC_D)
