/* Symbol layer */
SUBS(COMBO_AND,  " && ",  KC_A,    KC_Z)
COMB(COMBO_LBRC, KC_LBRC, KC_S,    KC_X)
COMB(COMBO_LCBR, KC_LCBR, KC_D,    KC_C)
COMB(COMBO_LPRN, KC_LPRN, KC_F,    KC_V)
COMB(COMBO_LABK, KC_LABK, KC_G,    KC_B)
COMB(COMBO_RABK, KC_RABK, KC_H,    KC_N)
COMB(COMBO_RPRN, KC_RPRN, KC_J,    KC_M)
COMB(COMBO_RCBR, KC_RCBR, KC_K,    KC_COMM)
COMB(COMBO_RBRC, KC_RBRC, KC_L,    KC_DOT)
SUBS(COMBO_OR,   " || ",  KC_SCLN, KC_SLSH)

COMB(COMBO_EXLM, KC_EXLM, KC_Q,    KC_1)
COMB(COMBO_AT,   KC_AT,   KC_W,    KC_2)
COMB(COMBO_HASH, KC_HASH, KC_E,    KC_3)
COMB(COMBO_DLR,  KC_DLR,  KC_R,    KC_4)
COMB(COMBO_PERC, KC_PERC, KC_T,    KC_5)
COMB(COMBO_CIRC, KC_CIRC, KC_Y,    KC_6)
COMB(COMBO_AMPR, KC_AMPR, KC_U,    KC_7)
COMB(COMBO_ASTR, KC_ASTR, KC_I,    KC_8)
COMB(COMBO_PIPE, KC_PIPE, KC_O,    KC_9)
COMB(COMBO_PLUS, KC_PLUS, KC_P,    KC_0)

/* Meta macros */
COMB(COMBO_F11,   KC_F11,             KC_9, KC_BSPC)
COMB(COMBO_F12,   KC_F12,             KC_0, KC_BSPC)
COMB(COMBO_AF4,   LALT(KC_F4),        KC_7, KC_BSPC)
COMB(COMBO_CSE,   LCTL(LSFT(KC_ESC)), KC_6, KC_BSPC)
COMB(COMBO_JKESC, KC_ESC,             KC_J, KC_K)
COMB(COMBO_DFESC, KC_ESC,             KC_D, KC_F)
COMB(COMBO_CORST, QK_BOOT,            KC_Q, KC_W, KC_E, KC_R, KC_U, KC_I, KC_O, KC_P)

/* Lambda macros */
SUBS(COMBO_LMSY, " => ", KC_COMMA, KC_DOT)
SUBS(COMBO_LMAL, "() => {  }"SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT), KC_C, KC_COMMA)
SUBS(COMBO_LMAR, "() => {  }"SS_TAP(X_LEFT)SS_TAP(X_LEFT), KC_C, KC_DOT)
SUBS(COMBO_LMBL, "() => "SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT), KC_X, KC_COMMA)
SUBS(COMBO_LMBR, "() => ", KC_X, KC_DOT)

TOGG(COMBO_WASD, LAYER_GAMES, KC_W, KC_A, KC_S, KC_D)
