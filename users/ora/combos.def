SUBS(ABRK, "<>"SS_TAP(X_LEFT),   KC_GRAVE, KC_SCLN)
SUBS(PARN, "()"SS_TAP(X_LEFT),   KC_F, KC_J)
SUBS(CBRC, "{}"SS_TAP(X_LEFT),   KC_D, KC_K)
SUBS(ABRC, "[]"SS_TAP(X_LEFT),   KC_LBRC, KC_RBRC)
SUBS(QUTS, "''"SS_TAP(X_LEFT),   KC_A, KC_SLSH)
SUBS(QUTC, "''"SS_TAP(X_LEFT),   KC_A, KC_SCLN)
SUBS(DQUO, "\"\""SS_TAP(X_LEFT), KC_A, KC_QUOT)
SUBS(ABRK2, "<>"SS_TAP(X_LEFT),  KC_SCLN, KC_QUOT)

SUBS(SUIF, "if ()"SS_TAP(X_LEFT),      KC_B, KC_N)
SUBS(SUEL, "else if ()"SS_TAP(X_LEFT), KC_V, KC_M)
SUBS(SULM, "() => {}"SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT), KC_C, KC_COMMA)

COMB(COESC, KC_ESC, KC_J, KC_K)
COMB(CORST, QK_BOOT, KC_Q, KC_W, KC_E, KC_R, KC_U, KC_I, KC_O, KC_P)
