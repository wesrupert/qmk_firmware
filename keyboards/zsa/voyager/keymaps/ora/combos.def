/* Symbol layer */
SUBS(COMBO_QWER_AND,  " && ",  KC_A,    KC_Z)
COMB(COMBO_QWER_LBRC, KC_LBRC, KC_S,    KC_X)
COMB(COMBO_QWER_LCBR, KC_LCBR, KC_D,    KC_C)
COMB(COMBO_QWER_LPRN, KC_LPRN, KC_F,    KC_V)
COMB(COMBO_QWER_LABK, KC_LABK, KC_G,    KC_B)
COMB(COMBO_QWER_RABK, KC_RABK, KC_H,    KC_N)
COMB(COMBO_QWER_RPRN, KC_RPRN, KC_J,    KC_M)
COMB(COMBO_QWER_RCBR, KC_RCBR, KC_K,    KC_COMM)
COMB(COMBO_QWER_RBRC, KC_RBRC, KC_L,    KC_DOT)
SUBS(COMBO_QWER_OR,   " || ",  KC_SCLN, KC_SLSH)
COMB(COMBO_QWER_GRV,  KC_GRV,  MT_LGMN, MT_RGSN)
COMB(COMBO_QWER_EXLM, KC_EXLM, KC_Q,    KC_1)
COMB(COMBO_QWER_AT,   KC_AT,   KC_W,    KC_2)
COMB(COMBO_QWER_HASH, KC_HASH, KC_E,    KC_3)
COMB(COMBO_QWER_DLR,  KC_DLR,  KC_R,    KC_4)
COMB(COMBO_QWER_PERC, KC_PERC, KC_T,    KC_5)
COMB(COMBO_QWER_CIRC, KC_CIRC, KC_Y,    KC_6)
COMB(COMBO_QWER_AMPR, KC_AMPR, KC_U,    KC_7)
COMB(COMBO_QWER_ASTR, KC_ASTR, KC_I,    KC_8)
COMB(COMBO_QWER_PIPE, KC_PIPE, KC_O,    KC_9)
COMB(COMBO_QWER_PLUS, KC_PLUS, KC_P,    KC_0)
COMB(COMBO_QWER_RSET, QK_BOOT, KC_Q, KC_W, KC_E, KC_R, KC_U, KC_I, KC_O, KC_P)

SUBS(COMBO_GRPH_AND,  " && ",  KC_N,    KC_Q)
COMB(COMBO_GRPH_LBRC, KC_LBRC, KC_R,    KC_X)
COMB(COMBO_GRPH_LCBR, KC_LCBR, KC_T,    KC_M)
COMB(COMBO_GRPH_LPRN, KC_LPRN, KC_S,    KC_C)
COMB(COMBO_GRPH_LABK, KC_LABK, KC_G,    KC_V)
COMB(COMBO_GRPH_RABK, KC_RABK, KC_Y,    KC_K)
COMB(COMBO_GRPH_RPRN, KC_RPRN, KC_H,    KC_P)
COMB(COMBO_GRPH_RCBR, KC_RCBR, KC_A,    KC_COMM)
COMB(COMBO_GRPH_RBRC, KC_RBRC, KC_E,    KC_DOT)
SUBS(COMBO_GRPH_OR,   " || ",  KC_I,    KC_SLSH)
COMB(COMBO_GRPH_GRV,  KC_GRV,  MT_LGMN, MT_RGSN)
COMB(COMBO_GRPH_EXLM, KC_EXLM, KC_B,    KC_1)
COMB(COMBO_GRPH_AT,   KC_AT,   KC_L,    KC_2)
COMB(COMBO_GRPH_HASH, KC_HASH, KC_D,    KC_3)
COMB(COMBO_GRPH_DLR,  KC_DLR,  KC_W,    KC_4)
COMB(COMBO_GRPH_PERC, KC_PERC, KC_Z,    KC_5)
COMB(COMBO_GRPH_CIRC, KC_CIRC, KC_MINS, KC_6)
COMB(COMBO_GRPH_AMPR, KC_AMPR, KC_F,    KC_7)
COMB(COMBO_GRPH_ASTR, KC_ASTR, KC_O,    KC_8)
COMB(COMBO_GRPH_PIPE, KC_PIPE, KC_U,    KC_9)
COMB(COMBO_GRPH_PLUS, KC_PLUS, KC_J,    KC_0)
COMB(COMBO_GRPH_RSET, QK_BOOT, KC_B, KC_L, KC_D, KC_W, KC_F, KC_O, KC_U, KC_J)

COMB(COMBO_GRV2, KC_GRV, KC_DEL, KC_1)
COMB(COMBO_TILD, KC_TILD, KC_DEL, MT_LATB)

/* Meta macros */
COMB(COMBO_F11,   KC_F11,             KC_9, KC_BSPC)
COMB(COMBO_F12,   KC_F12,             KC_0, KC_BSPC)
COMB(COMBO_AF4,   LALT(KC_F4),        KC_7, KC_BSPC)
COMB(COMBO_CSE,   LCTL(LSFT(KC_ESC)), KC_6, KC_BSPC)
COMB(COMBO_JKESC, KC_ESC,             KC_J, KC_K)
COMB(COMBO_DFESC, KC_ESC,             KC_D, KC_F)

/* Lambda macros */
SUBS(COMBO_LMSY, " => ", KC_COMMA, KC_DOT)
SUBS(COMBO_LMAL, "() => {  }"SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT), KC_C, KC_COMMA)
SUBS(COMBO_LMAR, "() => {  }"SS_TAP(X_LEFT)SS_TAP(X_LEFT), KC_C, KC_DOT)
SUBS(COMBO_LMBL, "() => "SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT)SS_TAP(X_LEFT), KC_X, KC_COMMA)
SUBS(COMBO_LMBR, "() => ", KC_X, KC_DOT)

TOGG(COMBO_WASD, LAYER_GAMES, KC_W, KC_A, KC_S, KC_D)
