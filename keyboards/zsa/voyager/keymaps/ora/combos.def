COMB(COMBO_RSET, QK_BOOT, KC_Q, KC_W, KC_E, KC_R, KC_U, KC_I, KC_O, KC_P)

/* Symbol layer */
COMB(COMBO_W_TLD,  KC_TILD, MT_LCMN, MT_LAEQ)
COMB(COMBO_M_TLD,  KC_TILD, MT_LGMN, MT_LCEQ)
SUBS(COMBO_AND,    " && ",  HL_FNA,  KC_Z)
COMB(COMBO_W_LBRC, KC_LBRC, HM_LAS,  KC_X)
COMB(COMBO_M_LBRC, KC_LBRC, HM_LCS,  KC_X)
COMB(COMBO_LCBR,   KC_LCBR, HM_LSD,  KC_C)
COMB(COMBO_W_LPRN, KC_LPRN, HM_LCF,  KC_V)
COMB(COMBO_M_LPRN, KC_LPRN, HM_LGF,  KC_V)
COMB(COMBO_W_LABK, KC_LABK, HM_LGG,  KC_B)
COMB(COMBO_M_LABK, KC_LABK, HM_LAG,  KC_B)
COMB(COMBO_W_RABK, KC_RABK, HM_RGH,  KC_N)
COMB(COMBO_M_RABK, KC_RABK, HM_RAH,  KC_N)
COMB(COMBO_W_RPRN, KC_RPRN, HM_RCJ,  KC_M)
COMB(COMBO_M_RPRN, KC_RPRN, HM_RGJ,  KC_M)
COMB(COMBO_RCBR,   KC_RCBR, HM_RSK,  KC_COMM)
COMB(COMBO_W_RBRC, KC_RBRC, HM_RAL,  KC_DOT)
COMB(COMBO_M_RBRC, KC_RBRC, HM_RCL,  KC_DOT)
SUBS(COMBO_OR,     " || ",  HL_FNSC, KC_SLSH)
COMB(COMBO_W_GRV,  KC_GRV,  MT_RCQT, MT_RABL)
COMB(COMBO_M_GRV,  KC_GRV,  MT_RGQT, MT_RCBL)
COMB(COMBO_EXLM,   KC_EXLM, KC_Q,    KC_1)
COMB(COMBO_AT,     KC_AT,   KC_W,    KC_2)
COMB(COMBO_HASH,   KC_HASH, KC_E,    KC_3)
COMB(COMBO_DLR,    KC_DLR,  KC_R,    KC_4)
COMB(COMBO_PERC,   KC_PERC, KC_T,    KC_5)
COMB(COMBO_CIRC,   KC_CIRC, KC_Y,    KC_6)
